{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/decision.schema.json",
  "title": "Public intervention decision",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["dataMode"],
        "properties": { "dataMode": { "const": "live" } }
      },
      "then": {
        "required": ["rankedOpportunities"],
        "properties": { "rankedOpportunities": true }
      }
    },
    {
      "if": {
        "required": ["dataMode", "shouldPush"],
        "properties": { "dataMode": { "const": "live" }, "shouldPush": { "const": true } }
      },
      "then": { "properties": { "rankedOpportunities": { "type": "array", "minItems": 1 } } }
    }
  ],
  "required": [
    "schemaVersion", "episodeId", "policyVersion", "decision", "shouldPush", "reasonCodes",
    "score", "selectedOpportunity", "excludedCandidates", "notification", "dataMode", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "episodeId": { "$ref": "common.schema.json#/$defs/uuid" },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "decision": {
      "type": "string",
      "enum": ["do_not_push", "check_in_only", "suggest_solo_place", "suggest_light_social", "suggest_small_role"]
    },
    "shouldPush": { "type": "boolean" },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/reasonCode" }
    },
    "score": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
    "selectedOpportunity": {
      "oneOf": [
        { "$ref": "opportunity.schema.json" },
        { "type": "null" }
      ]
    },
    "rankedOpportunities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rankedOpportunity" }
    },
    "excludedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opportunityId", "reasonCodes"],
        "properties": {
          "opportunityId": { "type": "string", "minLength": 1 },
          "reasonCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/reasonCode" }
          }
        }
      }
    },
    "notification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "tone"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "tone": { "$ref": "common.schema.json#/$defs/pushTone" }
          }
        },
        { "type": "null" }
      ]
    },
    "dataMode": { "$ref": "common.schema.json#/$defs/dataMode" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  },
  "$defs": {
    "recommendationReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "text", "evidenceUrl", "classification"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["connection", "continuity", "solo_friendly", "personal_fit", "adjacent_interest", "calendar_fit", "travel_fit", "budget_fit"]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "classification": { "$ref": "common.schema.json#/$defs/sourceClassification" }
      }
    },
    "rankedOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "score", "opportunityId", "recommendationReasons", "exclusionReasons"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 8 },
        "score": { "type": "number", "minimum": -1, "maximum": 1 },
        "opportunityId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "recommendationReasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/recommendationReason" } },
        "exclusionReasons": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/reasonCode" } }
      }
    }
  }
}
