{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/event-route-result.schema.json",
  "title": "EventRouteResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "mode", "minutes", "source", "computedAt", "distanceMeters", "confidence", "resolvedAddress", "latitude", "longitude"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "mode": { "type": "string", "enum": ["walk", "transit"] },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "source": { "const": "maps_verified" },
    "computedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "distanceMeters": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "resolvedAddress": { "type": "string", "maxLength": 400 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
  }
}
