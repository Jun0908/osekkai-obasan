{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/common.schema.json",
  "title": "Osekkai common definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "dataMode": {
      "type": "string",
      "enum": ["demo", "live"]
    },
    "classification": {
      "type": "string",
      "enum": ["measured", "reference_estimate", "demo", "unverified"]
    },
    "sourceClassification": {
      "type": "string",
      "enum": [
        "raw_open_data",
        "live_provider",
        "ai_derived",
        "organizer_verified",
        "private_user_data",
        "synthetic_demo"
      ]
    },
    "eventStatus": {
      "type": "string",
      "enum": ["scheduled", "canceled", "sold_out", "registration_closed", "ended", "unknown"]
    },
    "registrationStatus": {
      "type": "string",
      "enum": ["open", "waitlist", "sold_out", "closed", "not_required", "unknown"]
    },
    "nullableDateTime": {
      "oneOf": [
        { "$ref": "#/$defs/dateTime" },
        { "type": "null" }
      ]
    },
    "socialIntensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "pushTone": {
      "type": "string",
      "enum": ["gentle", "casual", "direct", "quiet"]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "NO_PUSH_CONSENT",
        "QUIET_HOURS",
        "COOLDOWN_ACTIVE",
        "WEEKLY_LIMIT_REACHED",
        "EXPLICIT_PAUSE",
        "EXPLICIT_NO_ACTION",
        "HUMAN_SUPPORT_REQUIRED",
        "NO_FREE_WINDOW",
        "NO_VERIFIED_OPPORTUNITY",
        "OUTSIDE_FREE_WINDOW",
        "TRAVEL_LIMIT",
        "OVER_BUDGET",
        "SOCIAL_INTENSITY_LIMIT",
        "CONNECTION_LEVEL",
        "REGISTRATION_UNAVAILABLE",
        "INVALID_SOURCE",
        "SCORE_BELOW_THRESHOLD",
        "FREE_WINDOW_AVAILABLE",
        "LOW_SOCIAL_BATTERY",
        "LOW_CONVERSATION_REQUIREMENT",
        "WITHIN_TRAVEL_LIMIT",
        "UNDER_BUDGET"
      ]
    },
    "fieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["source_snapshot", "source_verified", "organizer_verified", "ai_derived", "synthetic_demo"]
        },
        "sourceUrl": { "type": "string", "format": "uri" },
        "capturedAt": { "$ref": "#/$defs/dateTime" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceField": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "url", "classification", "capturedAt", "confidence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "recurrence",
            "future_occurrence",
            "solo_friendly",
            "beginner_friendly",
            "structured_conversation",
            "shared_meal",
            "group_work",
            "role_available",
            "community_path",
            "capacity",
            "registration",
            "personal_fit",
            "risk"
          ]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "url": { "type": "string", "format": "uri" },
        "classification": { "$ref": "#/$defs/sourceClassification" },
        "capturedAt": { "$ref": "#/$defs/dateTime" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceField": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "inferredPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "createdAt"],
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "text": { "type": "string", "minLength": 1, "maxLength": 160 },
              "createdAt": { "$ref": "#/$defs/dateTime" }
            }
          }
        }
      }
    }
  }
}
