{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/community.schema.json",
  "title": "Event community",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "provider", "name", "description", "organizerName",
    "eventSeriesIds", "futureEventIds", "communityUrl", "sourceClassification",
    "sourceUpdatedAt", "fetchedAt", "revalidatedAt", "evidence"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
    "name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "description": { "type": "string", "maxLength": 5000 },
    "organizerName": { "type": ["string", "null"], "maxLength": 240 },
    "eventSeriesIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "futureEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "communityUrl": { "type": "string", "format": "uri" },
    "sourceClassification": { "$ref": "common.schema.json#/$defs/sourceClassification" },
    "sourceUpdatedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "fetchedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "revalidatedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
  }
}
