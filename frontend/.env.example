# P0: code and runtime data are deliberately separate.
OPENCLAW_ROOT=../agents-OpenClaw
OPENCLAW_PYTHON_BIN=python
OSEKKAI_DATA_ROOT=../agents-OpenClaw/data/osekkai

# Use a long random value outside demo-only local development.
OSEKKAI_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional during key rotation only.
OSEKKAI_SESSION_SECRET_PREVIOUS=

OSEKKAI_DEMO_MODE=true
OSEKKAI_TIMEZONE=Asia/Tokyo
OSEKKAI_DATA_RETENTION_DAYS=30
OSEKKAI_BRIDGE_TIMEOUT_MS=120000

# Instance-local resource guards. Concurrency is clamped to a maximum of 16.
OSEKKAI_BRIDGE_MAX_CONCURRENCY=4
OSEKKAI_BRIDGE_MAX_QUEUE=16
OSEKKAI_BRIDGE_QUEUE_TIMEOUT_MS=2000
OSEKKAI_RATE_LIMIT_REQUESTS=120
OSEKKAI_SESSION_ISSUE_RATE_LIMIT=60
OSEKKAI_RATE_LIMIT_WINDOW_MS=60000
OSEKKAI_RATE_LIMIT_MAX_KEYS=10000

# Set true only behind a reverse proxy that removes caller-supplied IP headers.
OSEKKAI_TRUST_PROXY_IP_HEADERS=false

# Live mode. Keep true for the deterministic offline demo; set false only
# after the credentials below are configured.
# OSEKKAI_DEMO_MODE=false

# Google Calendar OAuth. The redirect URI must exactly match the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OSEKKAI_CREDENTIAL_ENCRYPTION_KEY=

# Use separate restricted keys in production. Routes is server-only; Maps is
# browser-only and must be HTTP-referrer restricted.
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
OSEKKAI_ROUTES_TIMEOUT_SECONDS=12

# Demo origin is used only by the server-side live recommendation scheduler.
# Exact browser geolocation for the map is transient and is never stored.
OSEKKAI_LIVE_ORIGIN_LATITUDE=
OSEKKAI_LIVE_ORIGIN_LONGITUDE=
OSEKKAI_MAX_ROUTE_CANDIDATES=20
OSEKKAI_FREEBUSY_HORIZON_DAYS=30

# Authorized event feeds.
LUMA_ICAL_URL=
DOORKEEPER_API_TOKEN=
