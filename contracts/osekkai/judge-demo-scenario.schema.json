{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/judge-demo-scenario.schema.json",
  "title": "JudgeDemoScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scenarioSetId", "capturedAt", "snapshotNotice",
    "events", "stories", "dataNotes"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "scenarioSetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,79}$" },
    "capturedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "snapshotNotice": { "type": "string", "minLength": 1, "maxLength": 300 },
    "events": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/demoEvent" }
    },
    "stories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/story" }
    },
    "dataNotes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/dataNote" }
    }
  },
  "$defs": {
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rememberedPreferences", "memorySummary"],
      "properties": {
        "rememberedPreferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "memorySummary": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    },
    "freeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "start", "end", "classification"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "start": { "$ref": "common.schema.json#/$defs/dateTime" },
        "end": { "$ref": "common.schema.json#/$defs/dateTime" },
        "classification": { "const": "synthetic_demo" }
      }
    },
    "storyChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "userMessage", "agentReply", "understandingLabel",
        "eventOrder", "selectFirstEvent", "timeJumpLabel", "memoryOutcome"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "userMessage": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 220 },
            { "type": "null" }
          ]
        },
        "agentReply": { "type": "string", "minLength": 1, "maxLength": 360 },
        "understandingLabel": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 160 },
            { "type": "null" }
          ]
        },
        "eventOrder": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "selectFirstEvent": { "type": "boolean" },
        "timeJumpLabel": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 60 },
            { "type": "null" }
          ]
        },
        "memoryOutcome": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 280 },
            { "type": "null" }
          ]
        }
      }
    },
    "storyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "choices"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/storyChoice" }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "storyNumber", "kind", "kicker", "title", "summary", "judgePoint",
        "calendarLabel", "persona", "freeWindows", "openingReply", "steps",
        "candidateTitle", "candidateEmptyTitle", "candidateEmptyDetail", "closingLine"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,59}$" },
        "storyNumber": { "type": "integer", "minimum": 1, "maximum": 3 },
        "kind": {
          "type": "string",
          "enum": ["preference_discovery", "respectful_hold", "continuity_followup"]
        },
        "kicker": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 220 },
        "judgePoint": { "type": "string", "minLength": 1, "maxLength": 160 },
        "calendarLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "persona": { "$ref": "#/$defs/persona" },
        "freeWindows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/freeWindow" }
        },
        "openingReply": { "type": "string", "minLength": 1, "maxLength": 380 },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/storyStep" }
        },
        "candidateTitle": { "type": "string", "minLength": 1, "maxLength": 100 },
        "candidateEmptyTitle": { "type": "string", "minLength": 1, "maxLength": 140 },
        "candidateEmptyDetail": { "type": "string", "minLength": 1, "maxLength": 240 },
        "closingLine": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "demoEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "startsAt", "endsAt", "providerLabel", "sourceUrl",
        "sourceCapturedAt", "areaLabel", "priceLabel", "fitReason", "adjustedReason",
        "connectionLabel", "connectionEvidence", "route"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "startsAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "endsAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "providerLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceCapturedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "areaLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "priceLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fitReason": { "type": "string", "minLength": 1, "maxLength": 220 },
        "adjustedReason": { "type": "string", "minLength": 1, "maxLength": 220 },
        "connectionLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "connectionEvidence": { "type": "string", "minLength": 1, "maxLength": 320 },
        "route": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "minutes", "recordedAt", "classification"],
              "properties": {
                "mode": { "type": "string", "enum": ["walk", "transit"] },
                "minutes": { "type": "integer", "minimum": 1, "maximum": 360 },
                "recordedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
                "classification": { "const": "recorded_live" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "dataNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "classification", "detail"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "classification": {
          "type": "string",
          "enum": ["recorded_source_snapshot", "recorded_live", "synthetic_demo", "deterministic_replay"]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    }
  }
}
