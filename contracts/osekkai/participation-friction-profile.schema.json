{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/participation-friction-profile.schema.json",
  "title": "ParticipationFrictionProfile",
  "type": "object",
  "propertyNames": {
    "enum": [
      "search_fatigue", "first_time_anxiety", "stranger_anxiety", "group_size",
      "conversation_load", "travel_effort", "time_commitment", "cost",
      "low_social_energy", "push_aversion", "not_today"
    ]
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["value", "origin", "confidence", "evidence", "observedAt", "lastConfirmedAt"],
    "properties": {
      "value": { "const": true },
      "origin": { "type": "string", "enum": ["explicit", "inferred"] },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "referenceType", "referenceId", "text", "observedAt", "lastConfirmedAt"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/uuid" },
            "referenceType": { "type": "string", "enum": ["message", "feedback"] },
            "referenceId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "text": { "type": "string", "minLength": 1, "maxLength": 160 },
            "observedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
            "lastConfirmedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
          }
        }
      },
      "observedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
      "lastConfirmedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
    }
  }
}
