{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/source-registry.schema.json",
  "title": "Source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sources"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "kind", "accessMethod", "baseUrl", "termsUrl", "license",
        "attribution", "enabled", "authorized", "refreshMinutes", "staleAfterMinutes",
        "credentialEnv", "storagePolicy", "requiredForDemo"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "type": "string", "enum": ["open_data", "live_provider", "public_official_site", "organizer_intake", "deep_link"] },
        "accessMethod": { "type": "string", "enum": ["api", "ical", "json_ld", "html", "webhook", "manual"] },
        "baseUrl": { "type": "string", "format": "uri" },
        "termsUrl": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1, "maxLength": 160 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 500 },
        "enabled": { "type": "boolean" },
        "authorized": { "type": "boolean" },
        "refreshMinutes": { "type": "integer", "minimum": 5, "maximum": 10080 },
        "staleAfterMinutes": { "type": "integer", "minimum": 5, "maximum": 43200 },
        "credentialEnv": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$" } },
        "storagePolicy": { "type": "string", "enum": ["normalized_only", "metadata_and_normalized", "ephemeral"] },
        "requiredForDemo": { "type": "boolean" }
      }
    }
  }
}
