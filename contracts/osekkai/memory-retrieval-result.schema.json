{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/memory-retrieval-result.schema.json",
  "title": "MemoryRetrievalResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "userId", "query", "notes", "generatedAt"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "userId": { "$ref": "common.schema.json#/$defs/uuid" },
    "query": { "type": "string", "maxLength": 1000 },
    "notes": {
      "type": "array", "maxItems": 5,
      "items": { "$ref": "memory-note.schema.json" }
    },
    "generatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
