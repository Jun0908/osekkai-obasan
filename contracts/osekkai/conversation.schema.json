{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osekkai.local/contracts/conversation.schema.json",
  "title": "Conversation turn",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "userId", "role", "text", "remember", "createdAt"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "userId": { "$ref": "common.schema.json#/$defs/uuid" },
    "role": { "type": "string", "enum": ["user", "assistant"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "remember": { "type": "boolean" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
